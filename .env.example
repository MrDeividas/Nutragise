# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See README → Environment Setup.

# Supabase — Application project (Dashboard → Project Settings → API)
# https://supabase.com/dashboard/project/gtnjrauujrzkesaulius
SUPABASE_URL=https://gtnjrauujrzkesaulius.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe (Dashboard → Developers → API keys) — publishable key only; secret keys belong in Supabase Edge Function secrets
# Stripe = wallet deposits + challenge payments ONLY. Pro = RevenueCat / Apple IAP (never Stripe Checkout subscriptions).
# Use pk_test_… while developing; switch to pk_live_… (and sk_live_… in Edge secrets) for production.
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# RevenueCat (Dashboard → Project Settings → API keys) — public SDK keys, safe to ship in the app
# iOS handles Apple In-App Purchase; Android handles Google Play Billing.
REVENUECAT_IOS_API_KEY=appl_your_revenuecat_ios_key
REVENUECAT_ANDROID_API_KEY=goog_your_revenuecat_android_key

# DeepSeek + Sightengine — set as Supabase Edge Function secrets (NOT in the app/.env):
#   supabase secrets set DEEPSEEK_API_KEY=your_deepseek_api_key
#   supabase secrets set SIGHTENGINE_API_USER=your_api_user SIGHTENGINE_API_SECRET=your_api_secret
# Dashboards:
#   https://platform.deepseek.com
#   https://dashboard.sightengine.com/api-credentials
# Deploy proxies after setting secrets:
#   supabase functions deploy deepseek-chat
#   supabase functions deploy moderate-media

